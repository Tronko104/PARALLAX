{
  "name": "parallax-universe-simulator",
  "version": "2.0.0",
  "description": "PARALLAX — A Universe Beyond Observation. Procedural, infinite, persistent multi-scale universe simulator with WebGL2 raymarching (Vibe-Coded).",
  "author": {
    "name": "Tronko104",
    "email": "tronko104@users.noreply.github.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/Tronko104/PARALLAX",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tronko104/PARALLAX.git"
  },
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "start": "npm run bundle && electron .",
    "bundle": "node scripts/bundle_artifact.js",
    "dist:win": "npm run bundle && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run bundle && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.tronko104.parallax",
    "productName": "PARALLAX",
    "copyright": "Copyright © 2026 Tronko104",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/index.html",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PARALLAX",
      "artifactName": "PARALLAX-${version}-Windows-Setup.${ext}"
    },
    "portable": {
      "artifactName": "PARALLAX-${version}-Windows-Portable.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Science",
      "maintainer": "Tronko104 <tronko104@users.noreply.github.com>",
      "synopsis": "Procedural multi-scale universe simulator",
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "artifactName": "PARALLAX-${version}-Linux-${arch}.${ext}"
    }
  },
  "keywords": [
    "astrophysics",
    "procedural-universe",
    "webgl2",
    "raymarching",
    "cosmology",
    "exoplanets",
    "astrobiology",
    "vibe-coded"
  ]
}
